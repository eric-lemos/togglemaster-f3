# Terraform cache
**/.terraform/*

# Terraform state
*.tfstate
*.tfstate.*

# Crash logs
crash.log
crash.*.log

# Exclude all tfvars except the example files
# *.tfvars
# *.tfvars.json
!*.auto.tfvars.example
!terraform.tfvars.example

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Plan files
*.tfplan

# Terraform lock and CLI config
.terraformrc
terraform.rc
